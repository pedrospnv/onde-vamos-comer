PORT=3000
WEB_ORIGIN=http://localhost:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FOURSQUARE_API_KEY=
# Google Places stays off unless explicitly enabled; Google requests can be billed.
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
# Optional; enables Google Places Enterprise fields (ratings and price levels), which have a higher billing tier.
GOOGLE_PLACES_INCLUDE_ENTERPRISE_FIELDS=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Own curated catalog is the default. External providers only run when explicitly selected.
RESTAURANT_DATA_SOURCE=curated
# Use SUPABASE_SERVICE_ROLE_KEY only with the one-time data import script. Never expose it in VITE_* variables.
